# SQLite file for local use. For production point this at Postgres and
# change the datasource provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Sprint calendar: first Monday of the program and its time zone.
PROGRAM_START="2026-10-12"
PROGRAM_TZ="Europe/Kyiv"

# Public URL used in sign-in emails.
APP_URL="http://localhost:3000"

# Email sign-in links. Without SMTP_URL nothing is sent.
SMTP_URL=""            # e.g. smtp://user:pass@smtp.office365.com:587
MAIL_FROM="Gem Quest <gems@example.com>"

# Show the sign-in link on screen instead of emailing it. Local/demo only.
AUTH_DEV_LINKS="true"
