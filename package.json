{
  "name": "gem-quest",
  "version": "0.1.0",
  "private": true,
  "description": "PMI DNA: The Gem Quest \u2014 internal peer-recognition platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "rm -f prisma/test.db && DATABASE_URL=file:./test.db prisma db push --skip-generate >/dev/null && DATABASE_URL=file:./test.db PROGRAM_START=2026-10-12 tsx --test tests/*.test.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "motion": "^14.0.0",
    "next": "^15.5.27",
    "nodemailer": "^10.0.15",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}